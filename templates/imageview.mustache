{{!
    @template mod_securepdf/imageview

    One PDF page as an image, with page navigation.

    Example context (json):
    {
        "page": 2,
        "total": 3,
        "previous": true,
        "previousurl": "https://example.com/mod/securepdf/view.php?id=1&page=0",
        "next": true,
        "nexturl": "https://example.com/mod/securepdf/view.php?id=1&page=2",
        "pages": [
            {"page": 1, "url": "https://example.com/mod/securepdf/view.php?id=1&page=0"},
            {"page": 2, "url": "https://example.com/mod/securepdf/view.php?id=1&page=1"},
            {"page": 3, "url": "https://example.com/mod/securepdf/view.php?id=1&page=2"}
        ],
        "base64": "R0lGODlhAQABAAAAACw="
    }
}}
<div class="mod_securepdf_pages">{{#str}}page, mod_securepdf{{/str}} {{page}} / {{total}}</div>
<div class="mod_securepdf_pageslinks">
{{#previous}}
    <a href="{{previousurl}}"> &lt;&lt; </a>
{{/previous}}
{{#pages}}
    <a href="{{url}}"> {{page}} </a>
{{/pages}}
{{#next}}
    <a href="{{nexturl}}"> &gt;&gt; </a>
{{/next}}
</div>
<img class="mod_securepdf_slide" src="data:image/jpeg;base64,{{base64}}" alt="Page {{page}}" oncontextmenu="return false;">
