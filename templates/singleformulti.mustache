{{!
    @template mod_securepdf/singleformulti

    One PDF page as an image, used when all pages are shown on one page.

    Example context (json):
    {
        "page": 1,
        "base64": "R0lGODlhAQABAAAAACw="
    }
}}
<div class="mod_securepdf_single">
<img class="mod_securepdf_slide" src="data:image/jpeg;base64,{{base64}}" alt="Slide {{page}}" oncontextmenu="return false;">
</div>
<br>
